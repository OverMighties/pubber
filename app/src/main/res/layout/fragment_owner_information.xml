<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Button
        android:id="@+id/ownerInfo_button_sign"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:background="@drawable/button_shape_container"
        app:backgroundTint="@null"
        android:text="@string/sign_in"
        android:textColor="@color/on_secondary_container"
        android:layout_marginBottom="80dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.15"
        app:layout_constraintStart_toStartOf="parent" />


    <Button
        android:id="@+id/ownerInfo_button_signUp"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:background="@drawable/button_shape_container"
        android:text="@string/label_email_sign_up_add"
        android:textColor="@color/on_secondary_container"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.85"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/ownerInfo_button_sign" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ownerInfo_cl_formContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ownerInfo_button_sign">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/ownerInfo_inputLayout_pubName"
            style="@style/CustomTextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:visibility="gone"
            android:hint="@string/hint_pub_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/ownerInfo_editText_pubName"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:textColor="@color/on_surface" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/ownerInfo_inputLayout_password"
            style="@style/CustomTextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:layout_marginTop="15dp"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/textfield_icon_color_selector"
            android:hint="@string/hint_password"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ownerInfo_inputLayout_pubName">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/ownerInfo_editText_password"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:inputType="textPassword"
                android:textColor="@color/on_surface" />
        </com.google.android.material.textfield.TextInputLayout>






    </androidx.constraintlayout.widget.ConstraintLayout>

    <Button
        android:id="@+id/ownerInfo_button_send"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:background="@drawable/button_shape_secondary"
        android:text="@string/sign_in"
        android:layout_marginTop="12dp"
        android:textColor="@color/on_secondary"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintTop_toBottomOf="@id/ownerInfo_cl_formContent" />

    <TextView
        android:id="@+id/ownerInfo_TV_headline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="@string/collaboration_info_headline"
        android:textColor="@color/on_surface"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ownerInfo_button_send"/>

    <TextView
        android:id="@+id/ownerInfo_TV_collInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="@string/collaboration_info_text"
        app:layout_constraintStart_toStartOf="@+id/ownerInfo_TV_headline"
        app:layout_constraintTop_toBottomOf="@+id/ownerInfo_TV_headline" />

    <ImageView
        android:id="@+id/ownerInfo_IV_expand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/ownerInfo_TV_headline"
        app:layout_constraintStart_toEndOf="@+id/ownerInfo_TV_headline"
        app:layout_constraintTop_toTopOf="@+id/ownerInfo_TV_headline"
        app:srcCompat="@drawable/ic_expand_more_primary" />

</androidx.constraintlayout.widget.ConstraintLayout>